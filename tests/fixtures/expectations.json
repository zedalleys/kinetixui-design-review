{
  "$comment": "Methodology fixtures. Each case is run through the skill; 'expect' says what a correct review does. Matching is heuristic (regex) \u2014 the manual rubric in tests/RUBRIC.md is the authority. expect: flag (needs findings), no-flag (no P0-P2), notes (P2/P3 allowed, no P0/P1), tradeoff (disclosed decision; see maxSeverity).",
  "cases": [
    {
      "id": "tokens-good",
      "path": "fixtures/tokens/good",
      "mode": "tokens",
      "expect": "no-flag",
      "mustMatch": [
        "semantic|--color-action"
      ],
      "note": "Semantic token consumption. No P0/P1/P2 expected."
    },
    {
      "id": "tokens-bad",
      "path": "fixtures/tokens/bad",
      "mode": "tokens",
      "expect": "flag",
      "mustMatch": [
        "#3b82f6|hard-?coded",
        "SHOULD_USE_TOKEN|should use (a )?token|semantic"
      ],
      "maxSeverity": "P2",
      "note": "Hard-coded reusable-component color equal to a primitive; off-scale padding. Severity must not exceed P2."
    },
    {
      "id": "tokens-justified",
      "path": "fixtures/tokens/justified",
      "mode": "tokens",
      "expect": "no-flag",
      "mustMatch": [
        "JUSTIFIED|justified|intentional|artwork|hairline"
      ],
      "note": "FALSE-POSITIVE CONTROL: a 1px hairline and illustration path coordinates are justified literals."
    },
    {
      "id": "preview-direction-good",
      "path": "fixtures/preview-direction/good",
      "mode": "rtl",
      "expect": "no-flag",
      "mustMatch": [
        "scoped|container|provider"
      ]
    },
    {
      "id": "preview-direction-bad",
      "path": "fixtures/preview-direction/bad",
      "mode": "rtl",
      "expect": "flag",
      "mustMatch": [
        "documentElement",
        "leak|global|whole (site|page)|shell",
        "localStorage|persist"
      ],
      "minSeverity": "P1",
      "note": "Local demo mutates document root and persists it, with no stated intent => P1 leak."
    },
    {
      "id": "preview-direction-disclosed",
      "path": "fixtures/preview-direction/disclosed-global",
      "mode": "rtl",
      "expect": "tradeoff",
      "mustMatch": [
        "disclos|deliberate|intentional|trade-?off|ADR|adr-007",
        "scoped|provider|alternative|iframe"
      ],
      "maxSeverity": "P2",
      "mustNotMatch": [
        "unintended bug|accidental(ly)? (leak|bug|mutation)"
      ],
      "note": "FALSE-POSITIVE CONTROL: documented global-by-design must be evaluated as a trade-off, not reported as an unknown P1 bug."
    },
    {
      "id": "icons-good",
      "path": "fixtures/icons/good",
      "mode": "icons",
      "expect": "no-flag",
      "mustMatch": [
        "slot|replace|default"
      ]
    },
    {
      "id": "icons-bad",
      "path": "fixtures/icons/bad",
      "mode": "icons",
      "expect": "flag",
      "mustMatch": [
        "unicode|glyph",
        "replace|slot|override|contract",
        "aria|accessible name|label"
      ],
      "note": "Ordinary UI icons as text glyphs (P2) + an icon-only dismiss button with no accessible name (P1: control unusable to assistive tech).",
      "minSeverity": "P1"
    },
    {
      "id": "state-fidelity-good",
      "path": "fixtures/state-fidelity/good",
      "mode": "component",
      "expect": "no-flag",
      "mustMatch": [
        "single|derive|coherent|consistent"
      ]
    },
    {
      "id": "state-fidelity-bad",
      "path": "fixtures/state-fidelity/bad",
      "mode": "component",
      "expect": "flag",
      "mustMatch": [
        "Unlocked",
        "contradict|illustration|closed",
        "role=|switch|aria-checked|semantic"
      ],
      "minSeverity": "P1",
      "note": "'Unlocked' text with closed padlock; hard-coded text state; aria-checked on a plain button."
    },
    {
      "id": "spatial-good",
      "path": "fixtures/spatial-clearance/good",
      "mode": "component",
      "expect": "no-flag",
      "mustMatch": [
        "gap|clearance|16px"
      ]
    },
    {
      "id": "spatial-bad",
      "path": "fixtures/spatial-clearance/bad",
      "mode": "component",
      "expect": "flag",
      "mustMatch": [
        "overlap|ring|stroke|clearance",
        "\\b12\\b"
      ],
      "minSeverity": "P1",
      "mustNotMatch": [
        "add (more )?margin|shrink the (button|target)|reduce the (button|target)"
      ],
      "note": "Control sits on the gauge ring. Must be measured, and the fix must be structural, not an arbitrary margin or a smaller target."
    },
    {
      "id": "classes-inconsistency",
      "path": "fixtures/classes/inconsistency",
      "mode": "tokens",
      "expect": "notes",
      "mustMatch": [
        "INCONSISTENCY",
        "--color-brand",
        "--color-action-bg"
      ],
      "mustNotMatch": [
        "\\bDEFECT\\b[^\\n]{0,40}\\bP[0-1]\\b"
      ],
      "note": "Two parts disagree and no decision exists: INCONSISTENCY (P2 at most), not a DEFECT. No P0/P1."
    },
    {
      "id": "classes-risk",
      "path": "fixtures/classes/risk",
      "mode": "component",
      "expect": "notes",
      "mustMatch": [
        "RISK",
        "300",
        "confirm|check|test|shared token|couple"
      ],
      "note": "Duplicated duration that works today but can drift: RISK with a confirming check, not a DEFECT."
    },
    {
      "id": "classes-opportunity",
      "path": "fixtures/classes/opportunity",
      "mode": "component",
      "expect": "no-flag",
      "mustMatch": [
        "OPPORTUNITY",
        "PASS"
      ],
      "mustNotMatch": [
        "\\bDEFECT\\b"
      ],
      "note": "FALSE-POSITIVE CONTROL: correct, consistent duplicates are an OPPORTUNITY with no P-level; verdict PASS, never FAIL."
    },
    {
      "id": "adapter-vue",
      "path": "fixtures/adapters/vue-button",
      "mode": "tokens",
      "expect": "flag",
      "mustMatch": [
        "#3b82f6",
        "--color-action-bg|token",
        "scoped|slot|SFC|Vue"
      ],
      "mustNotMatch": [
        "useState|useEffect|forwardRef|JSX"
      ],
      "maxSeverity": "P2",
      "note": "Framework neutrality: judged with Vue mechanics (SFC/scoped/slot); no React idioms demanded. Hard-coded reusable color is P2."
    },
    {
      "id": "adapter-swiftui",
      "path": "fixtures/adapters/swiftui-card",
      "mode": "accessibility",
      "expect": "flag",
      "mustMatch": [
        "source-only|SOURCE-ONLY|V1",
        "Dynamic Type|font",
        "accessibilityLabel|VoiceOver|accessible name"
      ],
      "mustNotMatch": [
        "aria-label|aria-labelledby|role="
      ],
      "minSeverity": "P1",
      "note": "Native source-only review: reports source-only state; judges by SwiftUI idioms (accessibilityLabel, Dynamic Type); never demands ARIA. Glyph-only button without a name is P1."
    }
  ]
}
